# genalpha-bss — production environment template (Phase 4 hardening)
# Copy to production.env, fill EVERY CHANGE_ME, and never commit the copy.
# Generate strong values:  openssl rand -base64 24

# ---- core infrastructure ----
POSTGRES_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ---- machine (service-to-service) client secrets ----
# These MUST match the client secrets configured in each Keycloak realm.
# On first production install: regenerate every confidential client secret
# in Keycloak (bss + per-tenant realms), then mirror the values here.
OIDC_MACHINE_SECRET=CHANGE_ME

# ---- AI providers (only if enabled per tenant) ----
AI_API_KEY=

# ---- external seams (fill per signed contract, else leave empty = seam off) ----
ESP_API_KEY=
PSP_KLARNA_SECRET=
PSP_VIPPS_SECRET=
