target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# OS / logs / env
.DS_Store
*.log
.env

# Local tooling
.claude/settings.local.json

# Terraform / OpenTofu working directories (provider binaries, module clones)
.terraform/

# Node / Vite (apps/storefront)
node_modules/
dist/

# Claude Code local settings (per-developer permissions)
.claude/
ops/e2e/recordings/

# database dumps (ops/backup.sh) — never in git
backups/

# terraform state holds secrets in cleartext — NEVER in git
*.tfstate
*.tfstate.backup
.terraform/

# python seed caches
__pycache__/

# research-note PDFs are rendered on demand (docs/make-note-pdf.mjs), never committed
docs/*.pdf
ops/cloud/aws-demo/box.env
.ci-fleet.override.yml

# the back office's React island bundle: built in the image from apps/admin-console/island
apps/admin-console/site/island/
apps/admin-console/island/node_modules/
